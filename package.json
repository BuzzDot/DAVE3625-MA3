{
  "name": "form-fitness-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/unit/*.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:ui": "vitest run",
    "db:types": "node scripts/test-postgres.mjs --generate-types",
    "test:supabase": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local --import tsx --test tests/integration/*.test.ts",
    "test:hosted": "node scripts/verify-hosted.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "audit:hosted": "node scripts/audit-hosted.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "foods:preview": "node --import tsx scripts/import-matvaretabellen.mjs",
    "foods:import": "node --import tsx scripts/import-matvaretabellen.mjs --apply",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
